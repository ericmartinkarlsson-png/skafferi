{
  "entities": {
    "Product": {
      "path": "products/{productId}",
      "fields": {
        "id": { "type": "string", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product name" },
        "category": { "type": "string", "description": "Pantry category" },
        "quantity": { "type": "number", "description": "Current quantity in stock" },
        "unit": { "type": "string", "description": "Unit of measurement" },
        "expirationDate": { "type": "string", "description": "Expiration date ISO or empty" },
        "minQuantity": { "type": "number", "description": "Reorder threshold" },
        "barcode": { "type": "string", "description": "Barcode EAN/UPC", "optional": true },
        "locationDetails": { "type": "string", "description": "Shelf or storage location", "optional": true },
        "notes": { "type": "string", "description": "Optional notes", "optional": true },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "ShoppingItem": {
      "path": "shoppingItems/{itemId}",
      "fields": {
        "id": { "type": "string", "description": "Unique shopping item ID" },
        "name": { "type": "string", "description": "Item name" },
        "category": { "type": "string", "description": "Category" },
        "quantity": { "type": "number", "description": "Quantity to buy" },
        "unit": { "type": "string", "description": "Unit" },
        "isChecked": { "type": "boolean", "description": "Checked in cart" },
        "isAutoGenerated": { "type": "boolean", "description": "Generated from low stock threshold" },
        "productId": { "type": "string", "description": "Associated product ID", "optional": true },
        "addedAt": { "type": "string", "description": "ISO timestamp when added" }
      }
    }
  }
}
