rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Endast auktoriserade hushållsmedlemmar i Björnstugan tillåts
    function isHouseholdMember() {
      return request.auth != null &&
        request.auth.uid in [
          'SgCGRzSiwEbRwl46rNzi8ciPIr02',
          'ietPx6aZqNgkLfmVYYKTYWrvI9Y2'
        ];
    }

    match /products/{productId} {
      allow read, write: if isHouseholdMember();
    }

    match /shoppingItems/{itemId} {
      allow read, write: if isHouseholdMember();
    }
  }
}
